<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="es_GT"/>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="u" value="${sessionScope.usuario}"/>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${titulo}"/> | La Cosecha</title>
    <link href="${ctx}/lib/bootstrap/bootstrap.min.css" rel="stylesheet">
    <link href="${ctx}/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet">
    <link href="${ctx}/css/estilos.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg navbar-dark bg-verde sticky-top shadow-sm">
    <div class="container">
        <a class="navbar-brand fw-bold" href="${ctx}/inicio">La <span class="text-naranja-claro">Cosecha</span></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-label="Menú">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="${ctx}/inicio">Inicio</a></li>
                <li class="nav-item"><a class="nav-link" href="${ctx}/catalogo">Catálogo</a></li>
                <li class="nav-item"><a class="nav-link" href="${ctx}/nosotros">Nosotros</a></li>
                <li class="nav-item"><a class="nav-link" href="${ctx}/contacto">Contacto</a></li>
            </ul>
            <form class="d-flex me-lg-3 my-2 my-lg-0" action="${ctx}/catalogo" method="get" role="search">
                <input class="form-control form-control-sm rounded-pill buscador" type="search" name="q"
                       placeholder="Buscar productos..." value="<c:out value='${param.q}'/>" aria-label="Buscar">
            </form>
            <ul class="navbar-nav align-items-lg-center">
                <c:choose>
                    <c:when test="${empty u}">
                        <li class="nav-item"><a class="nav-link" href="${ctx}/login"><i class="bi bi-person"></i> Iniciar sesión</a></li>
                    </c:when>
                    <c:otherwise>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i> <c:out value="${u.nombre}"/>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <c:if test="${u.personal}">
                                    <li><a class="dropdown-item" href="${ctx}/admin/dashboard"><i class="bi bi-speedometer2"></i> Panel administrativo</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                </c:if>
                                <li><a class="dropdown-item" href="${ctx}/cliente/perfil"><i class="bi bi-person"></i> Mi cuenta</a></li>
                                <li><a class="dropdown-item" href="${ctx}/cliente/pedidos"><i class="bi bi-bag"></i> Mis pedidos</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form action="${ctx}/logout" method="post" class="px-3">
                                        <input type="hidden" name="csrf" value="${sessionScope.csrf}">
                                        <button class="btn btn-link p-0 text-danger text-decoration-none"><i class="bi bi-box-arrow-right"></i> Cerrar sesión</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </c:otherwise>
                </c:choose>
                <li class="nav-item ms-lg-2">
                    <a class="btn btn-naranja btn-sm rounded-pill px-3" href="${ctx}/carrito">
                        <i class="bi bi-cart3"></i> Carrito (${empty sessionScope.carrito ? 0 : sessionScope.carrito.cantidadTotal})
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>
<main class="flex-grow-1">
<div class="container mt-3">
    <c:if test="${not empty sessionScope.flashOk}">
        <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle"></i> <c:out value="${sessionScope.flashOk}"/>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <c:remove var="flashOk" scope="session"/>
    </c:if>
    <c:if test="${not empty sessionScope.flashError}">
        <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle"></i> <c:out value="${sessionScope.flashError}"/>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
        <c:remove var="flashError" scope="session"/>
    </c:if>
</div>
